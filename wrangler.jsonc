{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that this GitHub repo is connected to.
  "name": "the-asi-society",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // The files sit in the repo root. .assetsignore keeps the code and config private.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Mail can only ever go to these two verified inboxes.
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["ruksh.e.ibadat@gmail.com", "ruksh.e.ibadat@icloud.com"] }
  ],
  // At most 5 requests a minute from one address.
  "ratelimits": [
    { "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "MAIL_FROM": "join@asisociety.org",
    "NOTIFY_TO": "ruksh.e.ibadat@gmail.com,ruksh.e.ibadat@icloud.com"
  },
  "routes": [
    { "pattern": "asisociety.org", "custom_domain": true },
    { "pattern": "www.asisociety.org", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
